project_name: asair_temp_hum_dht11_dht22
package: platform
label: Third Party Hardware Drivers - DHT11/DHT22 - Temperature/Humidity Sensor (GPIO)
description: |
  This example project shows an example for DHT11/DHT22 Temperature and Humidity Sensors.
category: Example|Platform
quality: evaluation

filter:
  - name: Device Type
    value: [SoC]
  - name: MCU
    value: [32-bit MCU]
  - name: Project Difficulty
    value: [Beginner]

source:
  - path: app.c

include:
  - path: ""
    file_list:
      - path: app.h

component:
  - id: sl_main
  - id: syscalls
    from: wiseconnect3_sdk
  - id: si91x_memory_default_config
    from: wiseconnect3_sdk
  - id: sl_gpio
    from: wiseconnect3_sdk
  - id: sleeptimer
  - id: asair_temp_hum_dht11_dht22
    from: third_party_hw_drivers

sdk_extension:
  - id: wiseconnect3_sdk
    version: 3.5.2
  - id: third_party_hw_drivers
    version: 4.6.0

readme:
  - path: ../../documentation/example/asair_temp_hum_dht11_dht22/README.md

other_file:
  - path: ../../documentation/example/asair_temp_hum_dht11_dht22/image/create_example.png
    directory: image
  - path: ../../documentation/example/asair_temp_hum_dht11_dht22/image/connection.png
    directory: image
  - path: ../../documentation/example/asair_temp_hum_dht11_dht22/image/output.png
    directory: image

ui_hints:
  highlight:
    - path: README.md
      focus: true

post_build:
  path: ../../../utilities/postbuild_profile/wiseconnect_soc.slpb
