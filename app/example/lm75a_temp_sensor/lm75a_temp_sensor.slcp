project_name: lm75a_temp_sensor_series2
label: Third Party Hardware Drivers - LM75A - Temperature Sensor (Series 2)
package: platform

description: |
  This example demonstrates LM75A temperature sensor integration
  over I2C on Silicon Labs Series 2 devices.

category: Example|Platform
quality: evaluation

filter:
  - name: Device Type
    value: [SoC]
  - name: MCU
    value: [32-bit MCU]
  - name: Project Difficulty
    value: [Beginner]

source:
  - path: app.c

include:
  - path: ''
    file_list:
      - path: app.h

component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: iostream_usart
    instance: [vcom]
  - id: i2cspm
    instance: [qwiic]
  - id: app_log
  - id: tempsensor_lm75a
    from: third_party_hw_drivers

define:
  - name: DEBUG_EFM

sdk_extension:
  - id: third_party_hw_drivers
    version: 4.4.1

readme:
  - path: ../../documentation/example/lm75a_temp_sensor/README.md

other_file:
  - path: ../../documentation/example/lm75a_temp_sensor/image/connection.png
    directory: "image"

ui_hints:
  highlight:
    - path: README.md
      focus: true

